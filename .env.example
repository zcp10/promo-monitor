# Copie para .env e preencha. NUNCA compartilhe este arquivo.

# --- Telegram (sua conta, para LER os grupos) — https://my.telegram.org > API development tools
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/promo_monitor

# --- SQLite local (usado quando Supabase não está configurado)
DB_PATH=data/promo_monitor.db

# --- Bot de alertas (@BotFather) e o SEU chat_id (mande /start ao bot e use @userinfobot para ver o id)
TG_BOT_TOKEN=
TG_ALERT_CHAT_ID=

# --- Supabase (Project Settings > API). Use a service_role SÓ aqui no script, nunca no painel.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Fontes de preço
HASDATA_API_KEY=
REEF_API_KEY=
MELI_ACCESS_TOKEN=

# --- Opcional: extração com IA
ANTHROPIC_API_KEY=
